{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "annotations": {
      "stadtstack.io/release-set-sha256": "sha256:e9c69d57bf9d9b03a48b7a6b3d40d3e8187486590ab36e677663c68380709a5b",
      "stadtstack.io/source-revision": "db2dc5112bb2b96db1143ef6986f8055b1a1cee1"
    },
    "labels": {
      "app.kubernetes.io/component": "readonly-presentation",
      "app.kubernetes.io/name": "roebel-web-presentation",
      "app.kubernetes.io/part-of": "stadtstack",
      "stadtstack.io/authority": "none"
    },
    "name": "roebel-web-presentation",
    "namespace": "stadtstack-roebel-web-preview"
  },
  "spec": {
    "progressDeadlineSeconds": 600,
    "replicas": 3,
    "revisionHistoryLimit": 10,
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/name": "roebel-web-presentation"
      }
    },
    "strategy": {
      "rollingUpdate": {
        "maxSurge": 1,
        "maxUnavailable": 1
      },
      "type": "RollingUpdate"
    },
    "template": {
      "metadata": {
        "annotations": {
          "stadtstack.io/identity-attester-runtime-code-keccak256": "0x3c12a034ea9c2749c786497b5d50dcfaa4eff84860819d788517145a2276ee51",
          "stadtstack.io/identity-citizen-runtime-code-keccak256": "0x0131b35a46839c2c50e013a5702dd1a75ab2c079890711900071d56486d1bce4",
          "stadtstack.io/identity-contract-authority": "none",
          "stadtstack.io/identity-contract-set": "gnosis-staging-test-v2",
          "stadtstack.io/identity-contract-set-sha256": "sha256:9918582e065161dc5b62d08ca53b9d0f711700c3ebbec4ae35dabb47dffcf86d",
          "stadtstack.io/image-manifest": "sha256:33df9b850d5f39ccf2eb387359540ae886f05bec3a8f44ac030604c3c529351e",
          "stadtstack.io/public-config-sha256": "sha256:4c1e49cbcfbb6622551964eaeaae0089e745e0a6317855143502014d51b910df",
          "stadtstack.io/release": "roebel-mecky-conversation-v1",
          "stadtstack.io/release-contract-sha256": "sha256:11234f4fce5593c235b6a1684bba8af6a4d365f1518705daaf0035a3f992306c",
          "stadtstack.io/source-revision": "db2dc5112bb2b96db1143ef6986f8055b1a1cee1",
          "stadtstack.io/truth-state": "staging-synthetic-workflow",
          "stadtstack.io/update": "native-post-topic-mecky-flow"
        },
        "labels": {
          "app.kubernetes.io/component": "readonly-presentation",
          "app.kubernetes.io/name": "roebel-web-presentation",
          "app.kubernetes.io/part-of": "stadtstack",
          "stadtstack.io/authority": "none"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "env": [
              {
                "name": "ROEBEL_PUBLIC_DEPLOYMENT_PROFILE",
                "valueFrom": {
                  "configMapKeyRef": {
                    "key": "ROEBEL_PUBLIC_DEPLOYMENT_PROFILE",
                    "name": "roebel-web-public-runtime"
                  }
                }
              },
              {
                "name": "ROEBEL_PUBLIC_BASE_URL",
                "valueFrom": {
                  "configMapKeyRef": {
                    "key": "ROEBEL_PUBLIC_BASE_URL",
                    "name": "roebel-web-public-runtime"
                  }
                }
              },
              {
                "name": "ROEBEL_PUBLIC_SITE_URL",
                "valueFrom": {
                  "configMapKeyRef": {
                    "key": "ROEBEL_PUBLIC_SITE_URL",
                    "name": "roebel-web-public-runtime"
                  }
                }
              },
              {
                "name": "ROEBEL_PUBLIC_SUPABASE_URL",
                "valueFrom": {
                  "configMapKeyRef": {
                    "key": "ROEBEL_PUBLIC_SUPABASE_URL",
                    "name": "roebel-web-public-runtime"
                  }
                }
              },
              {
                "name": "ROEBEL_PUBLIC_SUPABASE_ANON_KEY",
                "valueFrom": {
                  "configMapKeyRef": {
                    "key": "ROEBEL_PUBLIC_SUPABASE_ANON_KEY",
                    "name": "roebel-web-public-runtime"
                  }
                }
              },
              {
                "name": "ROEBEL_FEED_SUPABASE_URL",
                "value": "http://roebel-tracer-postgrest.stadtstack-roebel-staging-lab.svc.cluster.local:3000"
              },
              {
                "name": "ROEBEL_FEED_SUPABASE_ANON_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "supabase-anon-key",
                    "name": "roebel-tracer-feed-runtime",
                    "optional": false
                  }
                }
              },
              {
                "name": "ROEBEL_PUBLIC_THIRDWEB_CLIENT_ID",
                "valueFrom": {
                  "configMapKeyRef": {
                    "key": "ROEBEL_PUBLIC_THIRDWEB_CLIENT_ID",
                    "name": "roebel-web-public-runtime"
                  }
                }
              },
              {
                "name": "ROEBEL_PUBLIC_IDENTITY_CONTRACT_SET",
                "value": "gnosis-staging-test-v2"
              },
              {
                "name": "ROEBEL_PUBLIC_ATTESTER_NFT_ADDRESS",
                "value": "0x76b558Feb869c77790431497554C9aa8797896Fa"
              },
              {
                "name": "ROEBEL_PUBLIC_CITIZEN_NFT_ADDRESS",
                "value": "0x4765cB681E8eB080B3191DD550E81eaA41907323"
              },
              {
                "name": "ROEBEL_PUBLIC_GNOSIS_BUNDLER_URL",
                "valueFrom": {
                  "configMapKeyRef": {
                    "key": "ROEBEL_PUBLIC_GNOSIS_BUNDLER_URL",
                    "name": "roebel-web-public-runtime"
                  }
                }
              },
              {
                "name": "ROEBEL_PUBLIC_STADTSTACK_BASE_URL",
                "valueFrom": {
                  "configMapKeyRef": {
                    "key": "ROEBEL_PUBLIC_STADTSTACK_BASE_URL",
                    "name": "roebel-web-public-runtime"
                  }
                }
              },
              {
                "name": "STADTSTACK_CIVIC_PROJECTION_UPSTREAM_URL",
                "value": "http://e2e-workbench.stadtstack-roebel-staging-lab.svc.cluster.local:18083/stadtstack-test/api"
              },
              {
                "name": "PUBLIC_MECKY_CHAT_URL",
                "value": "http://public-mecky.stadtstack-roebel-staging-lab.svc.cluster.local:18084"
              },
              {
                "name": "STADTSTACK_PUBLIC_CASE_BINDING_ORIGIN",
                "value": "http://roebel-case-public-binding.stadtstack-roebel-staging-lab.svc.cluster.local:18086"
              },
              {
                "name": "ROEBEL_ID_ISSUER",
                "value": "https://roebel-id.staging.agentcart.eu"
              },
              {
                "name": "WORKSPACE_CLIENT_ID",
                "value": "roebel-town-workspace-staging"
              },
              {
                "name": "WORKSPACE_CLIENT_SECRET",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "roebel-town-workspace-identity-v1",
                    "key": "client-secret",
                    "optional": false
                  }
                }
              },
              {
                "name": "WORKSPACE_APP_ORIGIN",
                "value": "https://roebel-web.staging.agentcart.eu"
              },
              {
                "name": "WORKSPACE_SESSION_DATABASE_URL",
                "value": "http://roebel-tracer-postgrest.stadtstack-roebel-staging-lab.svc.cluster.local:3000"
              },
              {
                "name": "WORKSPACE_SESSION_DATABASE_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "roebel-town-workspace-identity-v1",
                    "key": "session-database-key",
                    "optional": false
                  }
                }
              },
              {
                "name": "ROEBEL_ADMIN_REVIEW_CONFIG_FILE",
                "value": "/run/roebel-town-workspace/review-config.json"
              }
            ],
            "image": "ghcr.io/giraeffleaeffle/roebel-web-staging@sha256:210dae1009afaa40483c15cf842c8c5a0b54c9eb0ec7ec279bfb540aad7ba4c4",
            "imagePullPolicy": "IfNotPresent",
            "livenessProbe": {
              "failureThreshold": 3,
              "httpGet": {
                "path": "/impressum",
                "port": "http",
                "scheme": "HTTP"
              },
              "initialDelaySeconds": 30,
              "periodSeconds": 20,
              "successThreshold": 1,
              "timeoutSeconds": 3
            },
            "name": "web",
            "ports": [
              {
                "containerPort": 8080,
                "name": "http",
                "protocol": "TCP"
              }
            ],
            "readinessProbe": {
              "failureThreshold": 3,
              "httpGet": {
                "path": "/impressum",
                "port": "http",
                "scheme": "HTTP"
              },
              "periodSeconds": 10,
              "successThreshold": 1,
              "timeoutSeconds": 3
            },
            "resources": {
              "limits": {
                "cpu": "1",
                "memory": "1536Mi"
              },
              "requests": {
                "cpu": "200m",
                "memory": "512Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "readOnlyRootFilesystem": true
            },
            "startupProbe": {
              "failureThreshold": 36,
              "httpGet": {
                "path": "/impressum",
                "port": "http",
                "scheme": "HTTP"
              },
              "periodSeconds": 5,
              "successThreshold": 1,
              "timeoutSeconds": 3
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/tmp",
                "name": "tmp"
              },
              {
                "name": "town-workspace-review",
                "mountPath": "/run/roebel-town-workspace",
                "readOnly": true
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
        "securityContext": {
          "fsGroup": 65532,
          "runAsGroup": 65532,
          "runAsNonRoot": true,
          "runAsUser": 65532,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "terminationGracePeriodSeconds": 20,
        "topologySpreadConstraints": [
          {
            "labelSelector": {
              "matchLabels": {
                "app.kubernetes.io/name": "roebel-web-presentation"
              }
            },
            "maxSkew": 1,
            "topologyKey": "kubernetes.io/hostname",
            "whenUnsatisfiable": "DoNotSchedule"
          }
        ],
        "volumes": [
          {
            "emptyDir": {
              "sizeLimit": "128Mi"
            },
            "name": "tmp"
          },
          {
            "name": "town-workspace-review",
            "secret": {
              "secretName": "roebel-town-workspace-review-v1",
              "defaultMode": 288,
              "items": [
                {
                  "key": "review-config.json",
                  "path": "review-config.json"
                }
              ]
            }
          }
        ]
      }
    }
  }
}
