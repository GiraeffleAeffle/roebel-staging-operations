              {
                "name": "INPUT_RELAY_URL",
                "value": "ws://citizen-relay.stadtstack-roebel-staging-lab.svc.cluster.local:18081"
              },
              {
                "name": "OUTPUT_RELAY_URL",
                "value": "ws://agent-relay.stadtstack-roebel-staging-lab.svc.cluster.local:18081"
