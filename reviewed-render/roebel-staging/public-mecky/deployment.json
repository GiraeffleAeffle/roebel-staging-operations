    "template": {
      "metadata": {
        "annotations": {
          "stadtstack.io/image-manifest": "sha256:61fb0c5a4b41441e9beefbe8215bc4280e9388805cf924e0a0d80e96e0dd82ee",
          "stadtstack.io/inference-model": "Qwen/Qwen3.6-35B-A3B-FP8",
          "stadtstack.io/release": "roebel-mecky-model-compat-v1",
          "stadtstack.io/source-revision": "eb500149718bf0ccb66e4180f7bc83bb6822ff1e",
          "stadtstack.io/update": "retry-ordinary-conversation-inference"
        },
        "labels": {
          "app.kubernetes.io/component": "public-mecky",
          "app.kubernetes.io/part-of": "stadtstack-roebel-staging-lab"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "env": [
