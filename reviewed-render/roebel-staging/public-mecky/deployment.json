{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "annotations": {
      "stadtstack.io/release-set-sha256": "sha256:2d13f456f084b42558562933abd117f7f5ceb92281d1ab85c2944a19652296dd",
      "stadtstack.io/source-revision": "eb500149718bf0ccb66e4180f7bc83bb6822ff1e"
    },
    "labels": {
      "app.kubernetes.io/component": "public-mecky",
      "app.kubernetes.io/part-of": "stadtstack-roebel-staging-lab",
      "stadtstack.io/owner": "stadtstack-operations-private",
      "stadtstack.io/release": "roebel-staging-lab-v1",
      "stadtstack.io/synthetic": "true"
    },
    "name": "public-mecky",
    "namespace": "stadtstack-roebel-staging-lab"
  },
  "spec": {
    "progressDeadlineSeconds": 600,
    "replicas": 1,
    "revisionHistoryLimit": 10,
    "selector": {
