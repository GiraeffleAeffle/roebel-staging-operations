{
  "schemaVersion": "roebel_case_web_connection_proposal_v1",
  "namespace": "stadtstack-roebel-web-preview",
  "deployment": "roebel-web-presentation",
  "environmentAddition": {
    "name": "STADTSTACK_PUBLIC_CASE_BINDING_ORIGIN",
    "value": "http://roebel-case-public-binding.stadtstack-roebel-staging-lab.svc.cluster.local:18086"
  },
  "networkPolicy": "roebel-web-presentation",
  "egressAddition": {
    "to": [
      {
        "namespaceSelector": {
          "matchLabels": {
            "kubernetes.io/metadata.name": "stadtstack-roebel-staging-lab"
          }
        },
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/component": "case-public-binding",
            "app.kubernetes.io/part-of": "roebel-case-staging"
          }
        }
      }
    ],
    "ports": [
      {
        "port": 18086,
        "protocol": "TCP"
      }
    ]
  },
  "webSourceRevision": "d685cd9beb0942bcf2a05e6d3dab7c34f452ab78",
  "webImage": "ghcr.io/giraeffleaeffle/roebel-web-staging@sha256:dead362b486e7b89dd9628a8ea6f5982c2847ac4e10deedba925f6d88a95698f"
}
