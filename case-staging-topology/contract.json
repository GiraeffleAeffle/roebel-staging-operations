      ],
      "ports": [
        { "name": "admission", "port": 18085 },
        { "name": "private-outbox", "port": 18087 },
        { "name": "control-probe", "port": 18088 }
      ],
      "directProbePorts": [
        { "name": "control-probe", "port": 18088 }
      ],
      "servicePorts": [
        "admission",
        "private-outbox"
      ],
      "tokenAdapter": {
        "marker": "stadtstack.io/staging-token-adapter-v1",
        "environment": "staging",
        "productionRejected": true
      }
    },
    "public": {
      "deploymentName": "roebel-case-public-binding",
      "serviceAccount": "roebel-case-public-binding",
      "automountServiceAccountToken": false,
      "imagePullSecretsAllowed": false,
      "image": {
        "state": "blocked",
        "immutableDigestOnly": true,
        "provenanceRequired": true,
        "sbomRequired": true,
        "value": null
      },
      "preexistingSecretRefs": [],
      "preexistingSecretRefUsage": {},
      "preexistingPersistentVolumeClaimRefs": [],
      "forbiddenReferences": [
        "Secret",
        "PersistentVolumeClaim",
        "Role",
        "RoleBinding",
        "ClusterRole",
        "ClusterRoleBinding",
        "token"
      ],
      "ports": [
        { "name": "public", "port": 18086 },
        { "name": "public-probe", "port": 18089 }
      ],
      "directProbePorts": [
        { "name": "public-probe", "port": 18089 }
      ],
      "servicePorts": [
        "public"
      ]
    }
