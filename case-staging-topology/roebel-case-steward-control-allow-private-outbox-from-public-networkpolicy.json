{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "labels": {
      "app.kubernetes.io/component": "case-steward-control",
      "app.kubernetes.io/part-of": "roebel-case-staging",
      "stadtstack.io/authority": "none"
    },
    "name": "roebel-case-steward-control-allow-private-outbox-from-public",
    "namespace": "stadtstack-roebel-staging-lab"
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "app.kubernetes.io/component": "case-steward-control",
        "app.kubernetes.io/part-of": "roebel-case-staging"
      }
    },
    "policyTypes": [
      "Ingress"
    ],
    "ingress": [
      {
        "from": [
          {
            "podSelector": {
              "matchLabels": {
                "app.kubernetes.io/component": "case-public-binding",
                "app.kubernetes.io/part-of": "roebel-case-staging"
              }
            }
          }
        ],
        "ports": [
          {
            "port": 18087,
            "protocol": "TCP"
          }
        ]
      }
    ]
  }
}
